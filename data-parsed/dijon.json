  {
    "id": "qzOhOT",
    "body": "1404 Philippe II de Bourgogne (Philippe le Hardi)",
    "indent": 1,
    "image": ""
  },
  {
    "id": "7YjiA5",
    "body": "il a fondé la puissance de la maison de Bourgogne et a été le premier duc de Bourgogne de la dynastie des Valois",
    "indent": 2,
    "image": ""
  },
  {
    "id": "MrsmZS",
    "body": "1419 Jean sans Peur",
    "indent": 1,
    "image": ""
  },
  {
    "id": "HAQG8M",
    "body": "il a renforcé la puissance de la Bourgogne et joué un rôle majeur dans la guerre civile entre les Armagnacs et les Bourguignons au début du XVe siècle",
    "indent": 2,
    "image": ""
  },
  {
    "id": "agi7zQ",
    "body": "1467 Philippe le Bon",
    "indent": 1,
    "image": ""
  },
  {
    "id": "Hl2OKQ",
    "body": "il a considérablement agrandi et renforcé l’État bourguignon au XVe siècle",
    "indent": 2,
    "image": ""
  },
